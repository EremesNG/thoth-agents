{
  "name": "@thoth-agents/pi-claude-bridge",
  "version": "0.1.0",
  "private": false,
  "description": "Pi extension that uses Claude Code (via Agent SDK) as a model provider and adds an AskClaude tool.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk"
  ],
  "author": "Eli Dickinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EremesNG/thoth-agents.git",
    "directory": "pi-packages/pi-claude-bridge"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "test:unit": "node --import tsx --import ./tests/lib/setup.mjs --test tests/unit-*.mjs",
    "test": "set -a && [ -f .env.test ] && . .env.test; set +a; CLAUDE_BRIDGE_TEST_LOG_DIR=$(mktemp -d); export CLAUDE_BRIDGE_TEST_LOG_DIR; pnpm run test:unit && tests/int-smoke.sh && tests/int-multi-turn.sh && tests/int-cache.sh && node --import tsx --test tests/int-*.mjs && node tests/lib/check-deadlock-logs.mjs \"$CLAUDE_BRIDGE_TEST_LOG_DIR\"",
    "test:usage": "tests/usage-test.sh",
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-pi-extensions.mjs pi-claude-bridge"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typebox": "^1.3.7",
    "typescript": "^6.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4",
    "@thoth-agents/pi-core": "workspace:^"
  },
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
