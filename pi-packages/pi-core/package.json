{
  "name": "@thoth-agents/pi-core",
  "version": "0.3.0",
  "private": false,
  "description": "Typed, versioned event contracts for the Thoth Pi ecosystem.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "thoth",
    "events"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./history-panel": "./src/history-panel.ts",
    "./panel": "./src/panel.ts",
    "./testing": "./src/testing.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EremesNG/thoth-agents.git",
    "directory": "pi-packages/pi-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@rolldown/binding-wasm32-wasi": "^1.2.4"
  }
}
