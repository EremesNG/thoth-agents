{
  "name": "@thoth-agents/pi-background-tasks",
  "version": "0.2.0",
  "description": "Pi extension for durable background shell tasks, watchers, logs, and status inspection.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "background-tasks",
    "watchers"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/1aboveio/pi-better-harness/main/docs/images/package-gallery/pi-better-background-tasks.png"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EremesNG/thoth-agents.git",
    "directory": "pi-packages/pi-background-tasks"
  },
  "bugs": {
    "url": "https://github.com/1aboveio/pi-better-harness/issues"
  },
  "homepage": "https://github.com/1aboveio/pi-better-harness/tree/main/packages/pi-better-background-tasks#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/conditions.test.ts src/runtime.test.ts",
    "test:e2e": "vitest run src/e2e.test.ts",
    "test:cross-session": "vitest run src/e2e.test.ts -t \"different session\"",
    "test:golden": "vitest run src/golden-path.test.ts",
    "test:integration": "npm run test:e2e && npm run test:golden",
    "build": "node ../../scripts/build-pi-extensions.mjs pi-background-tasks"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "typebox": "*",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@rolldown/binding-wasm32-wasi": "^1.2.4",
    "@thoth-agents/pi-core": "workspace:^"
  },
  "upstream": {
    "repository": "https://github.com/1aboveio/pi-better-harness",
    "commit": "86876e8369a673892a10c4e8df15460386ad0132",
    "directory": "packages/pi-better-background-tasks"
  }
}
