{
  "name": "thoth-agents",
  "version": "0.5.1",
  "description": "Adaptive multi-harness orchestration with six roles, runtime-autonomous AI-first execution routes, and external provider boundaries.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "thoth-agents": "./dist/cli/index.js"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai",
    "agents",
    "orchestration",
    "llm",
    "claude",
    "gpt",
    "sdd",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EremesNG/thoth-agents"
  },
  "bugs": {
    "url": "https://github.com/EremesNG/thoth-agents/issues"
  },
  "homepage": "https://github.com/EremesNG/thoth-agents#readme",
  "files": [
    "dist",
    "skills",
    "plugin",
    "pi",
    "thoth-agents.schema.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "pnpm run integration:sync && tsup && tsc --emitDeclarationOnly && pnpm run generate-schema && pnpm run build:pi-extensions",
    "generate-schema": "tsx scripts/generate-schema.ts",
    "integration:sync": "tsx src/harness/generate-integration-packages.ts",
    "integration:verify": "vitest run src/harness/generate-integration-packages.test.ts src/harness/integration-lifecycle.test.ts",
    "verify:pi-package": "node scripts/verify-pi-package.mjs",
    "setup:codex:local": "pnpm run build && tsx scripts/setup-codex-local.ts",
    "setup:pi:local": "pnpm run build && node scripts/setup-pi-local.mjs",
    "release:notes": "tsx scripts/generate-release-notes.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pi-extensions": "node --test --test-timeout=110000 scripts/pi-extension-bundles.test.mjs",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "dev": "pnpm run build && opencode",
    "prepublishOnly": "pnpm run build && pnpm run integration:verify",
    "version": "pnpm run integration:sync && pnpm run integration:verify && git add -- plugin",
    "release:marketplace": "node scripts/publish-marketplace.mjs",
    "release:pi": "node scripts/release-pi.mjs",
    "release:patch": "npm version patch --ignore-scripts=false && git push --follow-tags",
    "release:minor": "npm version minor --ignore-scripts=false && git push --follow-tags",
    "release:major": "npm version major --ignore-scripts=false && git push --follow-tags",
    "build:pi-extensions": "node scripts/build-pi-extensions.mjs"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opencode-ai/plugin": "1.18.2",
    "@opencode-ai/sdk": "1.18.2",
    "hosted-git-info": "9.0.3",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "semver": "^7.8.5",
    "unique-names-generator": "^4.7.1",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "which": "^6.0.0",
    "yaml": "2.9.0",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/hosted-git-info": "3.0.5",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "esbuild": "0.28.2",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "4.22.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.6"
  },
  "overrides": {
    "hono": "4.12.19",
    "postcss": "8.5.14",
    "tsx": "4.22.4"
  }
}
