{
  "name": "@thoth-agents/pi-todo",
  "version": "0.1.0",
  "private": false,
  "description": "Session-owned task lists, context reinjection, and state snapshots for Pi.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "todo",
    "tasks"
  ],
  "main": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EremesNG/thoth-agents.git",
    "directory": "pi-packages/pi-todo"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:real-sdk": "vitest run test/packed-real-sdk.test.ts"
  },
  "files": [
    "index.ts",
    "todo.ts",
    "todo-panel.ts",
    "todo-visibility.ts",
    "todo-work-panel.ts",
    "state/**/*.ts",
    "tool/**/*.ts",
    "view/**/*.ts",
    "!**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@thoth-agents/pi-core": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "@earendil-works/pi-ai": ">=0.99.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@rolldown/binding-wasm32-wasi": "^1.2.4"
  }
}
